{
  "name": "decklattice",
  "version": "0.1.0",
  "description": "DeckLattice CLI for building and validating structured Reveal.js slide decks",
  "type": "module",
  "bin": {
    "decklattice": "dist/cli.js"
  },
  "files": [
    ".skills/",
    "dist/",
    "templates/",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && tsc -p tsconfig.test.json && node --test dist-test/test/**/*.test.js",
    "check": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "prepare": "npm run build"
  },
  "keywords": [
    "decklattice",
    "cli",
    "reveal.js",
    "slides",
    "presentation"
  ],
  "author": "daichi-629",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/daichi-629/DeckLattice.git"
  },
  "bugs": {
    "url": "https://github.com/daichi-629/DeckLattice/issues"
  },
  "homepage": "https://github.com/daichi-629/DeckLattice#readme",
  "license": "MIT",
  "dependencies": {
    "fast-xml-parser": "^5.2.5",
    "js-beautify": "^1.15.4",
    "playwright": "^1.60.0"
  },
  "devDependencies": {
    "@types/js-beautify": "^1.14.3",
    "@types/node": "^22.15.30",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": ">=20"
  }
}
