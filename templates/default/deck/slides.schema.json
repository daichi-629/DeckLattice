{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/decklattice/slides.schema.json",
  "title": "DeckLattice slide deck",
  "type": "object",
  "required": ["deck_title", "slides"],
  "properties": {
    "deck_title": { "type": "string", "minLength": 1 },
    "short_title": { "type": "string", "minLength": 1 },
    "lang": { "type": "string", "minLength": 2 },
    "audience": { "type": "string" },
    "tone": { "type": "string" },
    "additional_css": {
      "type": "array",
      "items": { "type": "string", "pattern": "\\.css$" },
      "uniqueItems": true
    },
    "slides": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/slide" }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "base": {
      "type": "object",
      "required": ["id", "type"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
        },
        "type": {
          "enum": [
            "title",
            "section",
            "message",
            "two_column",
            "three_column",
            "image_right",
            "full_image",
            "chart",
            "mermaid",
            "math",
            "quote",
            "code",
            "summary",
            "metrics",
            "process",
            "table",
            "timeline",
            "references"
          ]
        },
        "headline": { "type": "string", "minLength": 1, "maxLength": 80 },
        "chart_alt": { "type": "string", "minLength": 1 },
        "chart_config": {
          "type": "object",
          "required": ["type", "data"],
          "properties": {
            "type": { "type": "string", "minLength": 1 },
            "data": { "type": "object" },
            "options": { "type": "object" }
          },
          "additionalProperties": true
        },
        "speaker_note": { "type": "string", "minLength": 1, "maxLength": 4000 },
        "additional_classes": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z_][A-Za-z0-9_-]*$"
          },
          "uniqueItems": true
        }
      }
    },
    "slide": {
      "allOf": [
        { "$ref": "#/$defs/base" },
        {
          "oneOf": [
            {
              "properties": { "type": { "const": "title" } },
              "required": ["headline"]
            },
            {
              "properties": { "type": { "const": "section" } },
              "required": ["headline"]
            },
            {
              "properties": { "type": { "const": "message" } },
              "anyOf": [
                { "required": ["message"] },
                { "required": ["message_lines"] }
              ]
            },
            {
              "properties": { "type": { "const": "two_column" } },
              "required": ["headline", "left", "right"]
            },
            {
              "properties": { "type": { "const": "three_column" } },
              "required": ["headline", "columns"]
            },
            {
              "properties": { "type": { "const": "image_right" } },
              "required": ["headline", "items", "image_url", "image_alt"]
            },
            {
              "properties": { "type": { "const": "full_image" } },
              "required": ["headline", "image_url", "image_alt"]
            },
            {
              "properties": { "type": { "const": "chart" } },
              "required": ["headline", "items"]
            },
            {
              "properties": { "type": { "const": "mermaid" } },
              "required": ["headline", "diagram"]
            },
            {
              "properties": { "type": { "const": "math" } },
              "required": ["headline", "equation"]
            },
            {
              "properties": { "type": { "const": "quote" } },
              "required": ["quote"]
            },
            {
              "properties": { "type": { "const": "code" } },
              "required": ["headline", "code"]
            },
            {
              "properties": { "type": { "const": "summary" } },
              "required": ["headline", "items"]
            },
            {
              "properties": { "type": { "const": "metrics" } },
              "required": ["headline", "metrics"]
            },
            {
              "properties": { "type": { "const": "process" } },
              "required": ["headline", "steps"]
            },
            {
              "properties": { "type": { "const": "table" } },
              "required": ["headline", "columns", "rows"]
            },
            {
              "properties": { "type": { "const": "timeline" } },
              "required": ["headline", "events"]
            },
            {
              "properties": { "type": { "const": "references" } },
              "required": ["headline", "items"]
            }
          ]
        }
      ]
    }
  }
}
